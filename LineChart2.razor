@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="line-chart">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <div class="line-chart-title">@Title</div>
    }
    <div class="line-chart-host">
        <canvas @ref="_canvas"></canvas>
    </div>
</div>

<script>
    window.LineChart ??= {
        render(canvas, data) {
            canvas._data = data;

            if (!canvas._resizeObserver) {
                canvas._resizeObserver = new ResizeObserver(() => this.draw(canvas));
                canvas._resizeObserver.observe(canvas.parentElement);
            }

            this.draw(canvas);
        },

        dispose(canvas) {
            canvas._resizeObserver?.disconnect();
        },

        draw(canvas) {
            const { _data: data, parentElement: parent } = canvas;
            if (!data?.length || !parent) return;

            // 1. Centralized CSS-Variable Theme Resolution
            const computed = getComputedStyle(canvas);
            const css = (prop, fallback) => computed.getPropertyValue(prop).trim() || fallback;
            
            const theme = {
                axisFont: css('--lc-axis-font', '12px system-ui, sans-serif'),
                axisTextColor: css('--lc-axis-text-color', '#9ca3af'),
                gridColor: css('--lc-grid-color', '#e5e7eb'),
                gridLineWidth: parseFloat(css('--lc-grid-line-width', '1')),
                titleFont: css('--lc-title-font', '600 13px system-ui, sans-serif'),
                titleTextColor: css('--lc-title-text-color', '#4b5563'),
                lineColor: css('--lc-line-color', '#ef4444'),
                lineWidth: parseFloat(css('--lc-line-width', '2'))
            };

            // 2. Layout & High-DPI Canvas Setup
            const { clientWidth: width, clientHeight: height } = parent;
            const ratio = window.devicePixelRatio || 1;
            
            canvas.style.width = `${width}px`;
            canvas.style.height = `${height}px`;
            canvas.width = width * ratio;
            canvas.height = height * ratio;

            const ctx = canvas.getContext("2d");
            ctx.setTransform(ratio, 0, 0, ratio, 0, 0);

            const left = 70, right = 30, top = 20, bottom = 60;
            const plotWidth = width - left - right;
            const plotHeight = height - top - bottom;

            const xMax = Math.max(1, data.length - 1);
            let min = Math.min(...data);
            let max = Math.max(...data);

            if (min === max) {
                min -= 1;
                max += 1;
            }

            const getX = (index) => left + (index / xMax) * plotWidth;
            const getY = (value) => top + plotHeight - ((value - min) / (max - min)) * plotHeight;

            // 3. Smart Tick Generator
            const getTicks = (start, end, forceInteger) => {
                const range = end - start || 1;
                const magnitude = 10 ** Math.floor(Math.log10(range / 4));
                let step = magnitude * [1, 2, 5, 10].find(n => (range / 4) / magnitude <= n);
                
                if (forceInteger) step = Math.max(1, Math.round(step));
                
                const ticks = [];
                const epsilon = step * 0.01;
                
                for (let v = Math.ceil(start / step) * step; v < end - epsilon; v += step) {
                    if (v > start + epsilon) ticks.push(v);
                }
                    
                if (ticks.length > 0 && (ticks[0] - start) / range < 0.15) ticks.shift();
                if (ticks.length > 0 && (end - ticks[ticks.length - 1]) / range < 0.15) ticks.pop();
                
                return [start, ...ticks, end];
            };

            ctx.clearRect(0, 0, width, height);
            
            // 4. Draw Grid & Axes
            ctx.font = theme.axisFont;
            ctx.fillStyle = theme.axisTextColor;
            ctx.strokeStyle = theme.gridColor;
            ctx.lineWidth = theme.gridLineWidth;
            ctx.beginPath();

            ctx.textAlign = "right";
            ctx.textBaseline = "middle";
            for (const tick of getTicks(min, max, false)) {
                const y = getY(tick);
                const label = Number.isInteger(tick) ? tick : parseFloat(tick.toFixed(2));
                
                ctx.fillText(label, left - 16, y);
                ctx.moveTo(left, y);
                ctx.lineTo(width - right, y);
            }

            ctx.textAlign = "center";
            ctx.textBaseline = "top";
            for (const tick of getTicks(0, xMax, true)) {
                const x = getX(tick);
                
                ctx.fillText(Math.round(tick), x, top + plotHeight + 12);
                ctx.moveTo(x, top);
                ctx.lineTo(x, top + plotHeight);
            }
            ctx.stroke();

            // 5. Draw Titles
            ctx.fillStyle = theme.titleTextColor;
            ctx.font = theme.titleFont;
            ctx.fillText("Index", left + plotWidth / 2, height - 10);
            
            ctx.save();
            ctx.translate(10, top + plotHeight / 2);
            ctx.rotate(-Math.PI / 2);
            ctx.fillText("Value", 0, 0);
            ctx.restore();

            // 6. Draw Trend Line
            ctx.strokeStyle = theme.lineColor;
            ctx.lineWidth = theme.lineWidth;
            ctx.lineJoin = "round";
            ctx.beginPath();
            
            for (let i = 0; i < data.length; i++) {
                const x = getX(i);
                const y = getY(data[i]);
                i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
            }
            ctx.stroke();
        }
    };
</script>

<style>
    .line-chart {
        /* CSS API - Override these on parent elements to theme the chart */
        --lc-axis-font: 12px system-ui, sans-serif;
        --lc-axis-text-color: #9ca3af;
        --lc-grid-color: #e5e7eb;
        --lc-grid-line-width: 1;
        --lc-title-font: 600 13px system-ui, sans-serif;
        --lc-title-text-color: #4b5563;
        --lc-line-color: #ef4444;
        --lc-line-width: 2;

        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
    }

    .line-chart-title {
        text-align: center;
        font: var(--lc-title-font);
        color: var(--lc-title-text-color);
        padding-bottom: 12px;
    }

    .line-chart-host {
        flex: 1;
        position: relative;
        min-height: 0;
    }

    .line-chart-host canvas {
        position: absolute;
        inset: 0;
    }
</style>

@code {
    private ElementReference _canvas;

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public IReadOnlyList<double> Data { get; set; } = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("LineChart.render", _canvas, Data);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("LineChart.dispose", _canvas);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException)
        {
            // Safely ignore teardown errors when the user navigates away or closes the browser
        }
    }
}

@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="line-chart">

    <!-- Title -->
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <div class="line-chart__title">@Title</div>
    }

    <!-- Chart Host -->
    <div class="line-chart__host">
    
        <!-- Chart -->
        <canvas @ref="_canvas" class="line-chart__canvas"></canvas>
    </div>
</div>

<script>
    // --- State Management ---
    const chartState = new WeakMap();

    // --- Configuration Constants ---
    const TARGET_TICK_COUNT = 4;
    const TICK_MULTIPLIERS = [1, 2, 5, 10];
    const MAX_DECIMAL_PLACES = 4;

    const PADDING = { left: 70, right: 30, top: 20, bottom: 60 };
    const Y_AXIS_LABEL_OFFSET = 16;
    const X_AXIS_LABEL_OFFSET = 12;
    const X_TITLE_BOTTOM_OFFSET = 10;
    const Y_TITLE_LEFT_OFFSET = 10;
    const ROTATION_90_DEG_CCW = -Math.PI / 2;

    // --- Math Functions ---
    const getExtremes = (data) => {
        let min = Infinity;
        let max = -Infinity;
        
        for (let i = 0; i < data.length; i++) {
            const value = data[i];
            if (value < min) min = value;
            if (value > max) max = value;
        }
        
        if (min === max) {
            return { min: min - 1, max: max + 1 };
        }
        
        return { min, max };
    };

    const getTicks = (start, end, forceInteger) => {
        const range = end - start || 1;
        const rawStep = range / TARGET_TICK_COUNT;
        const magnitude = 10 ** Math.floor(Math.log10(rawStep));
        
        let step = magnitude * 10;
        for (const multiplier of TICK_MULTIPLIERS) {
            if (rawStep / magnitude <= multiplier) {
                step = magnitude * multiplier;
                break;
            }
        }
        
        if (forceInteger) {
            step = Math.max(1, Math.round(step));
        }
        
        const ticks = [];
        const firstTick = Math.ceil(start / step) * step;
        
        for (let value = firstTick; value < end; value += step) {
            if (value > start) {
                ticks.push(value);
            }
        }
        
        return [start, ...ticks, end];
    };

    // --- Color Theme ---
    const extractTheme = (canvas) => {
        const computed = getComputedStyle(canvas);
        const getCss = (prop, fallback) => computed.getPropertyValue(prop).trim() || fallback;
        
        return {
            axisFont: getCss('--line-chart-axis-font', '12px system-ui, sans-serif'),
            axisTextColor: getCss('--line-chart-axis-text-color', '#9ca3af'),
            gridColor: getCss('--line-chart-grid-color', '#e5e7eb'),
            gridLineWidth: 1,
            titleFont: getCss('--line-chart-title-font', '600 13px system-ui, sans-serif'),
            titleTextColor: getCss('--line-chart-title-text-color', '#4b5563'),
            lineColor: getCss('--line-chart-line-color', '#ef4444'),
            lineWidth: 2
        };
    };

    const setupCanvas = (canvas, width, height) => {
        const ratio = window.devicePixelRatio || 1;
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        canvas.width = width * ratio;
        canvas.height = height * ratio;

        const ctx = canvas.getContext("2d");
        ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
        ctx.clearRect(0, 0, width, height);
        
        return ctx;
    };

    const calculateLayout = (width, height, data) => {
        const plotWidth = Math.max(1, width - PADDING.left - PADDING.right);
        const plotHeight = Math.max(1, height - PADDING.top - PADDING.bottom);
        const xMax = Math.max(1, data.length - 1);
        const { min, max } = getExtremes(data);

        return {
            width, height,
            plotWidth, plotHeight,
            xMax, min, max,
            mapX: (index) => PADDING.left + (index / xMax) * plotWidth,
            mapY: (value) => PADDING.top + plotHeight - ((value - min) / (max - min)) * plotHeight
        };
    };

    const drawGridAndAxes = (ctx, layout, theme) => {
        ctx.font = theme.axisFont;
        ctx.fillStyle = theme.axisTextColor;
        ctx.strokeStyle = theme.gridColor;
        ctx.lineWidth = theme.gridLineWidth;
        ctx.beginPath();

        // Y-Axis
        ctx.textAlign = "right";
        ctx.textBaseline = "middle";
        const yTicks = getTicks(layout.min, layout.max, false);
        
        for (const tick of yTicks) {
            const y = layout.mapY(tick);
            const label = +tick.toFixed(MAX_DECIMAL_PLACES);
            
            ctx.fillText(label, PADDING.left - Y_AXIS_LABEL_OFFSET, y);
            ctx.moveTo(PADDING.left, y);
            ctx.lineTo(layout.width - PADDING.right, y);
        }

        // X-Axis
        ctx.textAlign = "center";
        ctx.textBaseline = "top";
        const xTicks = getTicks(0, layout.xMax, true);
        
        for (const tick of xTicks) {
            const x = layout.mapX(tick);
            const label = Math.round(tick);
            
            ctx.fillText(label, x, PADDING.top + layout.plotHeight + X_AXIS_LABEL_OFFSET);
            ctx.moveTo(x, PADDING.top);
            ctx.lineTo(x, PADDING.top + layout.plotHeight);
        }
        
        ctx.stroke();
    };

    const drawTitles = (ctx, layout, theme, xTitle, yTitle) => {
        ctx.fillStyle = theme.titleTextColor;
        ctx.font = theme.titleFont;
        
        const xTitleX = PADDING.left + (layout.plotWidth / 2);
        const xTitleY = layout.height - X_TITLE_BOTTOM_OFFSET;
        ctx.fillText(xTitle, xTitleX, xTitleY);
        
        const yTitleX = Y_TITLE_LEFT_OFFSET;
        const yTitleY = PADDING.top + (layout.plotHeight / 2);
        
        ctx.save();
        ctx.translate(yTitleX, yTitleY);
        ctx.rotate(ROTATION_90_DEG_CCW);
        ctx.fillText(yTitle, 0, 0);
        ctx.restore();
    };

    const drawStandardSeries = (ctx, layout, data) => {
        for (let i = 0; i < data.length; i++) {
            const x = layout.mapX(i);
            const y = layout.mapY(data[i]);
            
            if (i === 0) {
                ctx.moveTo(x, y);
            } else {
                ctx.lineTo(x, y);
            }
        }
    };

    const drawDenseSeries = (ctx, layout, data) => {
        const pointsPerPixel = data.length / layout.plotWidth;
        ctx.moveTo(layout.mapX(0), layout.mapY(data[0]));
        
        for (let pixel = 0; pixel < layout.plotWidth; pixel++) {
            const startIndex = Math.floor(pixel * pointsPerPixel);
            const endIndex = Math.min(Math.floor((pixel + 1) * pointsPerPixel), data.length);
            
            let localMin = Infinity;
            let localMax = -Infinity;
            
            for (let i = startIndex; i < endIndex; i++) {
                const value = data[i];
                if (value < localMin) localMin = value;
                if (value > localMax) localMax = value;
            }
            
            const x = PADDING.left + pixel;
            const lastValueInBucket = data[endIndex - 1];
            
            ctx.lineTo(x, layout.mapY(localMin));
            ctx.lineTo(x, layout.mapY(localMax));
            ctx.lineTo(x, layout.mapY(lastValueInBucket));
        }
    };

    const drawSeries = (ctx, layout, data, theme) => {
        ctx.strokeStyle = theme.lineColor;
        ctx.lineWidth = theme.lineWidth;
        ctx.lineJoin = "round";
        ctx.beginPath();
        
        if (data.length <= layout.plotWidth) {
            drawStandardSeries(ctx, layout, data);
        } else {
            drawDenseSeries(ctx, layout, data);
        }
        
        ctx.stroke();
    };

    // --- Component API ---
    window.LineChart ??= {
        render(canvas, data, xTitle, yTitle) {
            let state = chartState.get(canvas);
            
            if (!state) {
                state = {
                    theme: extractTheme(canvas),
                    observer: new ResizeObserver(() => this.draw(canvas))
                };
                state.observer.observe(canvas.parentElement);
                chartState.set(canvas, state);
            }
            
            state.data = data;
            state.xTitle = xTitle;
            state.yTitle = yTitle;
            
            this.draw(canvas);
        },

        dispose(canvas) {
            const state = chartState.get(canvas);
            if (state) {
                state.observer.disconnect();
                chartState.delete(canvas);
            }
        },

        draw(canvas) {
            const state = chartState.get(canvas);
            const parent = canvas.parentElement;
            
            if (!state || !state.data || state.data.length === 0 || !parent) {
                return;
            }

            const width = parent.clientWidth;
            const height = parent.clientHeight;
            
            if (width <= 0 || height <= 0) {
                return;
            }

            // Orchestrate Rendering
            const ctx = setupCanvas(canvas, width, height);
            const layout = calculateLayout(width, height, state.data);

            drawGridAndAxes(ctx, layout, state.theme);
            drawTitles(ctx, layout, state.theme, state.xTitle, state.yTitle);
            drawSeries(ctx, layout, state.data, state.theme);
        }
    };
</script>

<style>
    .line-chart {
        /* Color Theme */
        --line-chart-axis-font: 12px system-ui, sans-serif;
        --line-chart-axis-text-color: #9ca3af;
        --line-chart-grid-color: #e5e7eb;
        --line-chart-title-font: 600 13px system-ui, sans-serif;
        --line-chart-title-text-color: #4b5563;
        --line-chart-line-color: #ef4444;

        display: flex;
        flex-direction: column;

        width: 100%;
        height: 100%;
        min-width: 0;
    }

    .line-chart__title {
        min-width: 0;

        padding-bottom: 0.75rem;

        color: var(--line-chart-title-text-color);
        font: var(--line-chart-title-font);
        text-align: center;
    }

    .line-chart__host {
        position: relative;
        flex: 1;

        min-width: 0;
        min-height: 0;
    }

    .line-chart__canvas {
        position: absolute;
        inset: 0;
    }
</style>

@code {
    private ElementReference _canvas;
    private bool _isRendered; 

    [Parameter]
    public string Title { get; set; } = "Line Chart";

    [Parameter]
    public string XAxisTitle { get; set; } = "X Axis";

    [Parameter]
    public string YAxisTitle { get; set; } = "Y Axis";

    [Parameter, EditorRequired]
    public IReadOnlyList<double> Data { get; set; } = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _isRendered = true; 

        await JS.InvokeVoidAsync(
            "LineChart.render",
            _canvas,
            Data,
            XAxisTitle,
            YAxisTitle);
    }

    public async ValueTask DisposeAsync()
    {
        if (!_isRendered)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("LineChart.dispose", _canvas);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException)
        {
            // TO-DO
        }
    }
}

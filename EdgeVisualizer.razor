@using System.IO
@using System.Globalization
@using Microsoft.JSInterop

<div class="edge-visualizer @Class">

    <div class="edge-visualizer__header">
        @if (CurrentEdge != null)
        {
            <time class="edge-visualizer__timestamp"
                  datetime="@CurrentEdge.Timestamp">
                Timestamp: @CurrentEdge.Timestamp
            </time>
        }
    </div>

    <div class="edge-visualizer__body">
        @if (CurrentEdge != null && _edges.Count > 0)
        {
            <svg class="edge-visualizer__graph">

                <line class="edge-visualizer__axis"
                      x1="@($"{FormatPercent(AxisStartPercent)}%")"
                      y1="50%"
                      x2="@($"{FormatPercent(AxisEndPercent)}%")"
                      y2="50%" />

                @if (CurrentEdge.OpenSide is OpenSide.Left or OpenSide.Both)
                {
                    <g>
                        <circle class="edge-visualizer__point edge-visualizer__point--left"
                                cx="@($"{FormatPercent(GetXAxisPercent(CurrentEdge.OpenLeftX))}%")"
                                cy="50%"
                                r="8" />

                        <text class="edge-visualizer__label edge-visualizer__label--left"
                              x="@($"{FormatPercent(GetXAxisPercent(CurrentEdge.OpenLeftX))}%")"
                              y="35%"
                              text-anchor="@GetTextAnchor(CurrentEdge.OpenLeftX)">
                            L: @CurrentEdge.OpenLeftX.ToString("0.0")
                        </text>
                    </g>
                }

                @if (CurrentEdge.OpenSide is OpenSide.Right or OpenSide.Both)
                {
                    <g>
                        <circle class="edge-visualizer__point edge-visualizer__point--right"
                                cx="@($"{FormatPercent(GetXAxisPercent(CurrentEdge.OpenRightX))}%")"
                                cy="50%"
                                r="8" />

                        <text class="edge-visualizer__label edge-visualizer__label--right"
                              x="@($"{FormatPercent(GetXAxisPercent(CurrentEdge.OpenRightX))}%")"
                              y="70%"
                              text-anchor="@GetTextAnchor(CurrentEdge.OpenRightX)">
                            R: @CurrentEdge.OpenRightX.ToString("0.0")
                        </text>
                    </g>
                }

            </svg>
        }
    </div>
</div>

<style>
    .edge-visualizer {
        --edge-visualizer-bg: #ffffff;
        --edge-visualizer-header-bg: #f8fafc;
        --edge-visualizer-axis: #e2e8f0;
        --edge-visualizer-text: #0f172a;
        --edge-visualizer-muted: #64748b;
        --edge-visualizer-left: #ef4444;
        --edge-visualizer-right: #3b82f6;

        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;

        background: var(--edge-visualizer-bg);
        color: var(--edge-visualizer-text);
    }

    .edge-visualizer__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;

        padding: 0.75rem 1rem;
        background: var(--edge-visualizer-header-bg);
    }

    .edge-visualizer__title {
        font-size: 1rem;
        font-weight: 600;
    }

    .edge-visualizer__timestamp {
        color: var(--edge-visualizer-muted);
        font-size: 0.875rem;
        font-weight: 600;
        text-align: left;
    }

    .edge-visualizer__body {
        flex: 1;
        min-height: 0;
        padding: 1rem;
    }

    .edge-visualizer__graph {
        width: 100%;
        height: 100%;
        display: block;
        overflow: visible;
    }

    .edge-visualizer__axis {
        stroke: var(--edge-visualizer-axis);
        stroke-width: 2px;
    }

    .edge-visualizer__point--left {
        fill: var(--edge-visualizer-left);
    }

    .edge-visualizer__point--right {
        fill: var(--edge-visualizer-right);
    }

    .edge-visualizer__label {
        font-size: 0.875rem;
        font-weight: 600;
    }

    .edge-visualizer__label--left {
        fill: var(--edge-visualizer-left);
    }

    .edge-visualizer__label--right {
        fill: var(--edge-visualizer-right);
    }
</style>

@code {
    public enum OpenSide
    {
        None,
        Left,
        Right,
        Both
    }

    public class DetectedEdge
    {
        public OpenSide OpenSide { get; set; } = OpenSide.None;
        public double OpenLeftX { get; set; } = -1;
        public double OpenRightX { get; set; } = -1;
        public string Timestamp { get; set; } = string.Empty;
    }

    [Parameter, EditorRequired] public IEnumerable<DetectedEdge> Data { get; set; } = Array.Empty<DetectedEdge>();
    [Parameter, EditorRequired] public DetectedEdge? CurrentEdge { get; set; }
    
    [Parameter] public string? Class { get; set; }

    private const double AxisStartPercent = 8;
    private const double AxisEndPercent = 92;

    private List<DetectedEdge> _edges = new();
    private double _minX;
    private double _maxX;

    protected override void OnParametersSet()
    {
        if (Data == null)
        {
            return;
        }

        _edges = Data
            .Where(edge => edge.OpenSide != OpenSide.None)
            .ToList();

        CalculateXAxisBoundaries();
    }

    private void CalculateXAxisBoundaries()
    {
        _minX = double.MaxValue;
        _maxX = double.MinValue;

        // Cumulative history is preserved by looking at all loaded edges
        var boundsList = new List<DetectedEdge>(_edges);
        if (CurrentEdge != null && !boundsList.Any(e => e.Timestamp == CurrentEdge.Timestamp))
        {
            boundsList.Add(CurrentEdge);
        }

        foreach (var edge in boundsList)
        {
            if (edge.OpenSide is OpenSide.Left or OpenSide.Both)
            {
                _minX = Math.Min(_minX, edge.OpenLeftX);
                _maxX = Math.Max(_maxX, edge.OpenLeftX);
            }

            if (edge.OpenSide is OpenSide.Right or OpenSide.Both)
            {
                _minX = Math.Min(_minX, edge.OpenRightX);
                _maxX = Math.Max(_maxX, edge.OpenRightX);
            }
        }

        // Handle empty or uninitialized bounds
        if (_minX == double.MaxValue || _maxX == double.MinValue)
        {
            _minX = 0;
            _maxX = 100;
            return;
        }

        // Surgical Fix 1: Symmetrical Single-Point / Zero-Span Protection
        // If there's only one coordinate in the history, pad it scale-appropriately so it doesn't default to 0..100 and get clamped
        if (Math.Abs(_maxX - _minX) < 1e-9)
        {
            var singleValue = _minX;
            var offset = Math.Max(1.0, Math.Abs(singleValue) * 0.1); 
            _minX = singleValue - offset;
            _maxX = singleValue + offset;
        }
        else
        {
            // Apply slight padding to the ends of the timeline so extreme values have room to breathe
            var span = _maxX - _minX;
            var padding = span * 0.05; // 5% cushion
            _minX -= padding;
            _maxX += padding;
        }
    }

    private double GetXAxisPercent(double value)
    {
        var range = _maxX - _minX;

        if (range <= 0)
        {
            return 50;
        }

        var normalized = (value - _minX) / range;
        normalized = Math.Clamp(normalized, 0, 1);

        return AxisStartPercent + normalized * (AxisEndPercent - AxisStartPercent);
    }

    // Surgical Fix 2: Culture-safe Layout Formatter
    // Converts coordinate decimals to standard periods (.) instead of localized commas (,)
    private string FormatPercent(double value)
    {
        return value.ToString("0.00", CultureInfo.InvariantCulture);
    }

    private string GetTextAnchor(double value)
    {
        var x = GetXAxisPercent(value);

        if (x <= AxisStartPercent + 4)
        {
            return "start";
        }

        if (x >= AxisEndPercent - 4)
        {
            return "end";
        }

        return "middle";
    }
}

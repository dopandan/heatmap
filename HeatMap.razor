@page "/"
@rendermode InteractiveServer
@implements IDisposable

<div style="width: 100%; height: 300px; border: 1px solid black;">
    <HeatMap Data="_data"
             MinXAxisDomain="1208"
             MinYAxisDomain="500" />
</div>

@code {
    private const int Width = 1208;
    private const int MaxHeight = 500;

    private readonly PeriodicTimer _timer = new(TimeSpan.FromMilliseconds(50));
    private readonly Random _random = new();

    private List<IReadOnlyList<double>> _rows = [];
    private IReadOnlyList<IReadOnlyList<double>> _data = [];

    private bool _disposed;

    protected override void OnInitialized()
    {
        _ = RunHeatmapStreamAsync();
    }

    private async Task RunHeatmapStreamAsync()
    {
        while (!_disposed && await _timer.WaitForNextTickAsync())
        {
            if (_rows.Count >= MaxHeight)
            {
                _rows.RemoveAt(0);
            }

            _rows.Add(BuildRandomRow());

            // New outer list reference so Blazor sees the parameter changed.
            _data = _rows.ToList();

            await InvokeAsync(StateHasChanged);
        }
    }

    private IReadOnlyList<double> BuildRandomRow()
    {
        var row = new double[Width];

        for (var x = 0; x < Width; x++)
        {
            var wave = Math.Sin((x + _rows.Count * 8) * 0.02);
            var noise = _random.NextDouble() * 120;

            row[x] = 350 + wave * 250 + noise;
        }

        return row;
    }

    public void Dispose()
    {
        _disposed = true;
        _timer.Dispose();
    }
}

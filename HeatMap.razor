@using System.IO
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="heatmap">
    <div class="heatmap__host">
         <canvas @ref="_canvasRef" class="heatmap__canvas"></canvas>
    </div>
</div>

<style>
    .heatmap__canvas {
        --heatmap-background: #ffffff;
        --heatmap-axis-font: 11px sans-serif;
        --heatmap-axis-text-color: #6b7280;
        --heatmap-title-font: 600 13px sans-serif;
        --heatmap-title-text-color: #374151;
        --heatmap-axis-line-color: #e5e7eb;

        display: block;
        outline: none;
        touch-action: none;
        background: var(--heatmap-background);
    }

    .heatmap,
    .heatmap__host,
    .heatmap__canvas {
        width: 100%;
        height: 100%;
    }
</style>

<script>
    window.HeatMap ??= (() => {
        const instances = new WeakMap();

        const cfg = {
            padding: 16, yAxisWidth: 60, xAxisHeight: 40, legendWidth: 110,
            yTickSpacing: 75, xTickSpacing: 110, minEndTickGap: 35, tickSize: 5,
            yTickTextGap: 8, xTickTextGap: 8, xTitleBottomGap: 5, legendBoxSize: 14,
            legendRowHeight: 22, legendTitleYOffset: 6, legendItemsYOffset: 24,
            legendTextXOffset: 22, opaqueAlpha: 255, minZoom: 1, maxZoom: 20, zoomStep: 1.1
        };

        const extractTheme = (canvas) => {
            const computed = getComputedStyle(canvas);
            const getCss = (prop, fallback) => computed.getPropertyValue(prop).trim() || fallback;

            return {
                axisFont: getCss('--heatmap-axis-font', '11px sans-serif'),
                axisTextColor: getCss('--heatmap-axis-text-color', '#6b7280'),
                titleFont: getCss('--heatmap-title-font', '600 13px sans-serif'),
                titleTextColor: getCss('--heatmap-title-text-color', '#374151'),
                axisLineColor: getCss('--heatmap-axis-line-color', '#e5e7eb'),
                legendBorderColor: getCss('--heatmap-legend-border-color', 'rgba(0, 0, 0, 0.15)')
            };
        };

        function getLayout(rect) {
            const plotX = cfg.padding + cfg.yAxisWidth;
            const plotY = cfg.padding;
            return {
                plotX, plotY,
                plotW: rect.width - plotX - cfg.legendWidth - cfg.padding,
                plotH: rect.height - plotY - cfg.xAxisHeight - cfg.padding
            };
        }

        function getColor(value, colors) {
            for (const color of colors) {
                if (value < color.threshold) return color;
            }
            return colors[colors.length - 1];
        }

        function formatThreshold(value) {
            return Number.isInteger(value) ? value.toString() : value.toFixed(2);
        }

        function getLegendLabel(colors, index) {
            if (index === colors.length - 1) {
                return `≥ ${formatThreshold(colors[index - 1]?.threshold ?? colors[index].threshold)}`;
            }
            return `< ${formatThreshold(colors[index].threshold)}`;
        }

        function resizeCanvas(canvas, ctx) {
            const dpr = window.devicePixelRatio || 1;
            const rect = canvas.getBoundingClientRect();
            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            ctx.clearRect(0, 0, rect.width, rect.height);
            return rect;
        }

        function clampView(instance) {
            const sourceW = instance.dataW / instance.zoom;
            const sourceH = instance.dataH / instance.zoom;
            instance.viewX = Math.max(0, Math.min(instance.viewX, Math.max(0, instance.dataW - sourceW)));
            instance.viewY = Math.max(0, Math.min(instance.viewY, Math.max(0, instance.dataH - sourceH)));
        }

        function getVisibleRange(instance, axis) {
            const isX = axis === "x";
            const domain = isX ? instance.dataW : instance.dataH;
            const start = isX ? instance.viewX : instance.viewY;
            const size = domain / instance.zoom;

            return {
                domain, start, size,
                first: Math.max(1, Math.floor(start) + 1),
                last: Math.min(domain, Math.ceil(start + size))
            };
        }

        function getTicks(first, last, pixels, spacing) {
            if (last <= first) return [first];

            const count = last - first + 1;
            const maxTicks = Math.max(2, Math.floor(pixels / spacing));
            const rawStep = count / maxTicks;
            const magnitude = Math.pow(10, Math.floor(Math.log10(rawStep || 1)));
            const normalized = rawStep / magnitude;
            const step = (normalized <= 2 ? 2 : normalized <= 5 ? 5 : 10) * magnitude;

            const ticks = [first];
            const start = Math.ceil(first / step) * step;

            for (let tick = start; tick < last; tick += step) {
                if (tick !== first) ticks.push(tick);
            }

            const finalGap = ((last - ticks[ticks.length - 1]) / count) * pixels;
            if (ticks.length > 1 && finalGap < cfg.minEndTickGap) ticks.pop();

            ticks.push(last);
            return ticks;
        }

        function drawHeatmap(instance, layout) {
            if (instance.dataW <= 0 || instance.dataH <= 0) return;
            clampView(instance);

            const sourceW = instance.dataW / instance.zoom;
            const sourceH = instance.dataH / instance.zoom;

            instance.ctx.imageSmoothingEnabled = false;
            instance.ctx.drawImage(
                instance.offscreen, instance.viewX, instance.viewY, sourceW, sourceH,
                layout.plotX, layout.plotY, layout.plotW, layout.plotH
            );
        }

        function setAxisStyle(instance) {
            const ctx = instance.ctx;
            ctx.fillStyle = instance.theme.axisTextColor;
            ctx.strokeStyle = instance.theme.axisLineColor;
            ctx.lineWidth = 1;
            ctx.font = instance.theme.axisFont;
        }

        function drawYAxis(instance, layout) {
            const ctx = instance.ctx;
            const range = getVisibleRange(instance, "y");

            ctx.beginPath();
            ctx.moveTo(layout.plotX, layout.plotY);
            ctx.lineTo(layout.plotX, layout.plotY + layout.plotH);
            ctx.stroke();

            ctx.textAlign = "right";
            ctx.textBaseline = "middle";

            for (const tick of getTicks(range.first, range.last, layout.plotH, cfg.yTickSpacing)) {
                const rawY = layout.plotY + ((tick - 0.5 - range.start) / range.size) * layout.plotH;
                const y = Math.max(layout.plotY, Math.min(rawY, layout.plotY + layout.plotH));

                ctx.fillText(tick.toString(), layout.plotX - cfg.yTickTextGap, y);
                ctx.beginPath();
                ctx.moveTo(layout.plotX - cfg.tickSize, y);
                ctx.lineTo(layout.plotX, y);
                ctx.stroke();
            }

            ctx.save();
            ctx.translate(cfg.padding, layout.plotY + layout.plotH / 2);
            ctx.rotate(-Math.PI / 2);
            ctx.textAlign = "center";
            ctx.textBaseline = "top";
            ctx.fillStyle = instance.theme.titleTextColor;
            ctx.font = instance.theme.titleFont;
            ctx.fillText(instance.config.yAxisTitle, 0, 0);
            ctx.restore();
        }

        function drawXAxis(instance, layout, rect) {
            const ctx = instance.ctx;
            const range = getVisibleRange(instance, "x");

            ctx.beginPath();
            ctx.moveTo(layout.plotX, layout.plotY + layout.plotH);
            ctx.lineTo(layout.plotX + layout.plotW, layout.plotY + layout.plotH);
            ctx.stroke();

            ctx.textAlign = "center";
            ctx.textBaseline = "top";

            for (const tick of getTicks(range.first, range.last, layout.plotW, cfg.xTickSpacing)) {
                const rawX = layout.plotX + ((tick - 0.5 - range.start) / range.size) * layout.plotW;
                const x = Math.max(layout.plotX, Math.min(rawX, layout.plotX + layout.plotW));

                ctx.fillText(tick.toString(), x, layout.plotY + layout.plotH + cfg.xTickTextGap);
                ctx.beginPath();
                ctx.moveTo(x, layout.plotY + layout.plotH);
                ctx.lineTo(x, layout.plotY + layout.plotH + cfg.tickSize);
                ctx.stroke();
            }

            ctx.fillStyle = instance.theme.titleTextColor;
            ctx.font = instance.theme.titleFont;
            ctx.fillText(instance.config.xAxisTitle, layout.plotX + layout.plotW / 2, rect.height - cfg.padding - cfg.xTitleBottomGap);
        }

        function drawLegend(instance, layout) {
            const ctx = instance.ctx;
            const colors = instance.config.colors;
            const x = layout.plotX + layout.plotW + cfg.padding;
            let y = layout.plotY;

            ctx.textAlign = "left";
            ctx.textBaseline = "middle";
            ctx.fillStyle = instance.theme.titleTextColor;
            ctx.font = instance.theme.titleFont;
            ctx.fillText("Legend", x, y + cfg.legendTitleYOffset);

            y += cfg.legendItemsYOffset;
            ctx.font = instance.theme.axisFont;

            for (let i = colors.length - 1; i >= 0; i--) {
                const color = colors[i];
                ctx.fillStyle = `rgb(${color.r}, ${color.g}, ${color.b})`;
                ctx.fillRect(x, y, cfg.legendBoxSize, cfg.legendBoxSize);

                ctx.strokeStyle = instance.theme.legendBorderColor;
                ctx.strokeRect(x, y, cfg.legendBoxSize, cfg.legendBoxSize);

                ctx.fillStyle = instance.theme.axisTextColor;
                ctx.fillText(getLegendLabel(colors, i), x + cfg.legendTextXOffset, y + cfg.legendBoxSize / 2);
                y += cfg.legendRowHeight;
            }
        }

        function draw(instance) {
            const rect = resizeCanvas(instance.canvas, instance.ctx);
            const layout = getLayout(rect);

            if (layout.plotW <= 0 || layout.plotH <= 0) return;

            instance.theme = extractTheme(instance.canvas);
            setAxisStyle(instance);
            drawHeatmap(instance, layout);
            drawYAxis(instance, layout);
            drawXAxis(instance, layout, rect);
            drawLegend(instance, layout);
        }

        function writePixels(values, pixels, colors) {
            for (let i = 0; i < values.length; i++) {
                const color = getColor(values[i], colors);
                const offset = i * 4;
                pixels[offset] = color.r;
                pixels[offset + 1] = color.g;
                pixels[offset + 2] = color.b;
                pixels[offset + 3] = cfg.opaqueAlpha;
            }
        }

        function wireInteraction(instance) {
            const canvas = instance.canvas;

            canvas.addEventListener("wheel", event => {
                event.preventDefault();
                instance.zoom *= event.deltaY < 0 ? cfg.zoomStep : 1 / cfg.zoomStep;
                instance.zoom = Math.max(cfg.minZoom, Math.min(cfg.maxZoom, instance.zoom));
                requestAnimationFrame(() => draw(instance));
            }, { passive: false });

            canvas.addEventListener("pointerdown", event => {
                instance.isPanning = true;
                instance.lastMouseX = event.clientX;
                instance.lastMouseY = event.clientY;
                canvas.setPointerCapture(event.pointerId);
            });

            canvas.addEventListener("pointermove", event => {
                if (!instance.isPanning || instance.dataW <= 0 || instance.dataH <= 0) return;

                const rect = canvas.getBoundingClientRect();
                const layout = getLayout(rect);
                const dx = event.clientX - instance.lastMouseX;
                const dy = event.clientY - instance.lastMouseY;

                instance.lastMouseX = event.clientX;
                instance.lastMouseY = event.clientY;

                instance.viewX -= dx * (instance.dataW / instance.zoom) / layout.plotW;
                instance.viewY -= dy * (instance.dataH / instance.zoom) / layout.plotH;

                requestAnimationFrame(() => draw(instance));
            });

            canvas.addEventListener("pointerup", event => {
                instance.isPanning = false;
                canvas.releasePointerCapture(event.pointerId);
            });

            canvas.addEventListener("pointercancel", () => {
                instance.isPanning = false;
            });
        }

        return {
            init(canvas, config) {
                if (!canvas) return;
                const offscreen = document.createElement("canvas");

                const instance = {
                    canvas, config, offscreen,
                    offscreenCtx: offscreen.getContext("2d"),
                    ctx: canvas.getContext("2d", { alpha: false, desynchronized: true }),
                    theme: extractTheme(canvas),
                    dataW: 0, dataH: 0, viewX: 0, viewY: 0, zoom: 1,
                    isPanning: false, lastMouseX: 0, lastMouseY: 0
                };

                instance.observer = new ResizeObserver(() => requestAnimationFrame(() => draw(instance)));
                instance.observer.observe(canvas);

                wireInteraction(instance);
                instances.set(canvas, instance);

                draw(instance);
            },

            async render(canvas, streamRef, width, height) {
                if (!canvas) return;
                const instance = instances.get(canvas);
                if (!instance) return;

                try {
                    const buffer = await streamRef.arrayBuffer();
                    const values = new Float64Array(buffer);

                    if (instance.offscreen.width !== width || instance.offscreen.height !== height) {
                        instance.offscreen.width = width;
                        instance.offscreen.height = height;
                    }

                    const image = new ImageData(width, height);
                    writePixels(values, image.data, instance.config.colors);

                    instance.offscreenCtx.putImageData(image, 0, 0);
                    instance.dataW = width;
                    instance.dataH = height;

                    requestAnimationFrame(() => draw(instance));
                } catch (err) {
                    // Stream may be aborted if component is disposed mid-flight
                }
            },

            clear(canvas) {
                if (!canvas) return;
                const instance = instances.get(canvas);
                if (!instance) return;

                instance.dataW = 0; instance.dataH = 0;
                instance.viewX = 0; instance.viewY = 0; instance.zoom = 1;
                instance.offscreen.width = 0; instance.offscreen.height = 0;

                requestAnimationFrame(() => draw(instance));
            },

            dispose(canvas) {
                if (!canvas) return;
                const instance = instances.get(canvas);
                if (!instance) return;

                instance.observer.disconnect();
                instances.delete(canvas);
            }
        };
    })();
</script>

@code {
    public record ColorStop(double Threshold, byte R, byte G, byte B);

    private const int BytesPerDouble = sizeof(double);

    [Parameter, EditorRequired] public IReadOnlyList<IReadOnlyList<double>> Data { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<ColorStop> Colors { get; set; } = [];

    [Parameter] public string XAxisTitle { get; set; } = "Sensor Index";
    [Parameter] public string YAxisTitle { get; set; } = "Scan";

    private ElementReference _canvasRef;
    private byte[] _buffer = [];
    private bool _busy;
    private bool _dirty;
    private bool _isDisposed;

    protected override bool ShouldRender() => false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        ValidateColors(Colors);

        await SafeInvokeVoidAsync("HeatMap.init", _canvasRef, new
        {
            colors = Colors,
            xAxisTitle = XAxisTitle,
            yAxisTitle = YAxisTitle
        });
    }

    public async Task RefreshAsync()
    {
        if (_busy || _isDisposed)
        {
            _dirty = true;
            return;
        }

        _busy = true;

        try
        {
            do
            {
                _dirty = false;
                await RenderLatestAsync();
            }
            while (_dirty && !_isDisposed);
        }
        finally
        {
            _busy = false;
        }
    }

    private static int ValidateAndGetWidth(IReadOnlyList<IReadOnlyList<double>> data)
    {
        if (data.Count == 0) return 0;
        var width = data[0].Count;

        if (width == 0)
            throw new InvalidOperationException("HeatMap rows must contain at least one value.");

        for (var row = 1; row < data.Count; row++)
        {
            if (data[row].Count != width)
                throw new InvalidOperationException("HeatMap data must be rectangular. Every row must have the same number of values.");
        }

        return width;
    }

    private static void ValidateColors(IReadOnlyList<ColorStop> colors)
    {
        if (colors.Count == 0)
            throw new InvalidOperationException("At least one heat map color must be provided.");

        for (var i = 1; i < colors.Count; i++)
        {
            if (colors[i].Threshold <= colors[i - 1].Threshold)
                throw new InvalidOperationException("HeatMap color thresholds must be strictly increasing.");
        }
    }

    private async Task RenderLatestAsync()
    {
        if (_isDisposed) return;

        var height = Data.Count;
        var width = ValidateAndGetWidth(Data);

        if (height == 0)
        {
            await SafeInvokeVoidAsync("HeatMap.clear", _canvasRef);
            return;
        }
        
        var byteCount = width * height * BytesPerDouble;

        if (_buffer.Length < byteCount)
            _buffer = new byte[byteCount];

        var offset = 0;

        for (var row = 0; row < height; row++)
        {
            for (var column = 0; column < width; column++)
            {
                BitConverter.TryWriteBytes(
                    _buffer.AsSpan(offset, BytesPerDouble),
                    Data[row][column]);

                offset += BytesPerDouble;
            }
        }

        using var stream = new MemoryStream(_buffer, 0, byteCount, writable: false);
        using var streamRef = new DotNetStreamReference(stream);

        await SafeInvokeVoidAsync("HeatMap.render", _canvasRef, streamRef, width, height);
    }

    public async ValueTask DisposeAsync()
    {
        if (_isDisposed) return;
        _isDisposed = true;
        await SafeInvokeVoidAsync("HeatMap.dispose", _canvasRef);
    }

    private async Task SafeInvokeVoidAsync(string identifier, params object?[] args)
    {
        if (_isDisposed) return;
        try
        {
            await JS.InvokeVoidAsync(identifier, args);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
        }
    }
}
